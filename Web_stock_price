def chart_main(df):
    """Close + MA100 + MA200 (line)."""
    fig, ax = plt.subplots(figsize=(10, 5))
    fig.patch.set_facecolor("#0e1117")
    ax.set_facecolor("#1e1e1e")

    ax.plot(df.index, df["Close"], color="#4CAF50", label="Close", linewidth=2)
    if "MA_100" in df.columns:
        ax.plot(df.index, df["MA_100"], color="#FFC107", label="MA 100", alpha=0.9)
    if "MA_200" in df.columns:
        ax.plot(df.index, df["MA_200"], color="#2196F3", label="MA 200", alpha=0.9)

    ax.legend(labelcolor="white")
    ax.tick_params(colors="white")
    ax.grid(True, linestyle="--", alpha=0.25)
    for s in ax.spines.values():
        s.set_visible(False)
    return fig_to_base64(fig)

def chart_open_close_hilo(df, days=120):
    """
    Open/Close line chart + today's high/low levels.
    Uses plain floats for high/low to avoid pandas Series issues.
    """
    sub = df.tail(days).copy()

    fig, ax = plt.subplots(figsize=(10, 4))
    fig.patch.set_facecolor("#0e1117")
    ax.set_facecolor("#1e1e1e")

    # Main lines
    ax.plot(sub.index, sub["Open"].values, label="Open", linewidth=1.4, alpha=0.8)
    ax.plot(sub.index, sub["Close"].values, label="Close", linewidth=1.8)

    # Today high/low as horizontal lines (force to float)
    try:
        today_high = safe_float(sub["High"].iloc[-1])
        today_low = safe_float(sub["Low"].iloc[-1])
    except Exception:
        today_high = None
        today_low = None

    if today_high is not None:
        ax.axhline(
            float(today_high),
            color="#22c55e",
            linestyle="--",
            linewidth=1.0,
            alpha=0.7,
            label="Today High",
        )
    if today_low is not None:
        ax.axhline(
            float(today_low),
            color="#ef4444",
            linestyle="--",
            linewidth=1.0,
            alpha=0.7,
            label="Today Low",
        )

    ax.tick_params(colors="white")
    ax.grid(True, linestyle="--", alpha=0.25)
    ax.legend(labelcolor="white", frameon=False)

    for s in ax.spines.values():
        s.set_visible(False)

    return fig_to_base64(fig)

def chart_area(df, days=180):
    """
    Simple line chart for Close (used in the 'Area' slot).
    No fill_between to avoid y1 dimension issues.
    """
    sub = df.tail(days).copy()

    x = np.arange(len(sub))
    y = sub["Close"].astype(float).values.reshape(-1)

    fig, ax = plt.subplots(figsize=(10, 4))
    fig.patch.set_facecolor("#0e1117")
    ax.set_facecolor("#020617")

    ax.plot(x, y, linewidth=1.8)

    ax.tick_params(colors="white")
    ax.grid(True, linestyle="--", alpha=0.25)
    ax.set_xticks([])  # hide 0..N-1 ticks

    for s in ax.spines.values():
        s.set_visible(False)

    return fig_to_base64(fig)

def chart_ohlc_bars(df, days=100):
    """OHLC bar chart (open-close-high-low) using vertical bars."""
    sub = df.tail(days)
    x = np.arange(len(sub))
    o = sub["Open"].values
    h = sub["High"].values
    l = sub["Low"].values
    c = sub["Close"].values

    fig, ax = plt.subplots(figsize=(10, 4))
    fig.patch.set_facecolor("#0e1117")
    ax.set_facecolor("#1e1e1e")

    bar_width = 0.3

    for i in range(len(sub)):
        # High-Low vertical line
        ax.vlines(x[i], l[i], h[i], color="#94a3b8", linewidth=1.2)
        # Open tick (left)
        ax.hlines(o[i], x[i] - bar_width, x[i], color="#22c55e", linewidth=1.4)
        # Close tick (right)
        ax.hlines(c[i], x[i], x[i] + bar_width, color="#f97316", linewidth=1.4)

    ax.set_xticks([])
    ax.tick_params(colors="white")
    ax.grid(True, axis="y", linestyle="--", alpha=0.25)
    for s in ax.spines.values():
        s.set_visible(False)

    return fig_to_base64(fig)

def chart_candlestick(df, days=60):
    """
    Candlestick chart using only scalar operations (no boolean indexing),
    green for up days, red for down days.
    """
    sub = df.tail(days).copy()

    # Force to 1D float numpy arrays
    x = np.arange(len(sub))
    o = sub["Open"].astype(float).values
    h = sub["High"].astype(float).values
    l = sub["Low"].astype(float).values
    c = sub["Close"].astype(float).values

    fig, ax = plt.subplots(figsize=(10, 4))
    fig.patch.set_facecolor("#0e1117")
    ax.set_facecolor("#020617")

    width = 0.5

    for i in range(len(sub)):
        # Choose candle color
        up = c[i] >= o[i]
        color = "#22c55e" if up else "#ef4444"

        # Wick: high-low
        ax.vlines(x[i], l[i], h[i], color=color, linewidth=1.0)

        # Body: bar
        top = max(o[i], c[i])
        bottom = min(o[i], c[i])
        height = top - bottom
        if height <= 0:
            height = 0.0001  # tiny visible body for doji-type candles

        ax.bar(
            x[i],
            height,
            width=width,
            bottom=bottom,
            color=color,
            edgecolor=color,
            linewidth=0.8,
            align="center",
        )

    ax.set_xticks([])
    ax.tick_params(colors="white")
    ax.grid(True, axis="y", linestyle="--", alpha=0.2)
    for s in ax.spines.values():
        s.set_visible(False)

    return fig_to_base64(fig)



