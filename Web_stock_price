# ----------------------------------------------------
# Helper formatting
# ----------------------------------------------------
def safe_float(v):
    try:
        # Handle Series / arrays safely
        if isinstance(v, pd.Series):
            if v.empty:
                return None
            v = v.iloc[0]
        elif isinstance(v, np.ndarray):
            if v.size == 0:
                return None
            v = v.flat[0]
        return float(v)
    except Exception:
        return None

def format_plain(v):
    try:
        # Allow Series as well
        if isinstance(v, pd.Series):
            if v.empty:
                return "-"
            v = v.iloc[0]
        return f"{float(v):,.2f}"
    except Exception:
        return "-"

def format_volume(v):
    try:
        # Allow Series as well
        if isinstance(v, pd.Series):
            if v.empty:
                return "-"
            v = v.iloc[0]
        v = float(v)
    except Exception:
        return "-"
    if v < 1_000:
        return f"{v:.0f}"
    if v < 100_000:
        return f"{v / 1_000:.2f}K"
    if v < 10_000_000:
        return f"{v / 100_000:.2f}L"
    return f"{v / 10_000_000:.2f}Cr"

def fig_to_base64(fig):
    buf = io.BytesIO()
    fig.savefig(buf, format="png", bbox_inches="tight", facecolor="#0e1117")
    buf.seek(0)
    encoded = base64.b64encode(buf.getvalue()).decode("utf-8")
    plt.close(fig)
    return encoded

