@app.route("/", methods=["GET", "POST"])
def index():
    ticker = "GOOG"
    if request.method == "POST":
        ticker = (request.form.get("ticker") or "GOOG").strip().upper()

    end = datetime.now()
    start = datetime(end.year - 20, end.month, end.day)
    df = yf.download(ticker, start=start, end=end, progress=False)

    if df.empty:
        return render_template_string(
            HTML_TEMPLATE,
            ticker=ticker,
            error=f"No data found for {ticker}",
            metrics=None,
            ma_plot=None,
            oc_hilo_plot=None,
            area_plot=None,
            ohlc_bar_plot=None,
            candle_plot=None,
            volume_plot=None,
            returns_plot=None,
            cumret_plot=None,
            intraday_plot=None,
            intraday_error="No intraday data",
            pred_error="No data",
            pred_plot=None,
            future_plot=None,
            news=[],
            raw_data="",
            datetime=datetime,
        )

    # Moving averages
    df["MA_100"] = df["Close"].rolling(100).mean()
    df["MA_200"] = df["Close"].rolling(200).mean()

    latest = safe_float(df["Close"].iloc[-1])
    prev = safe_float(df["Close"].iloc[-2])

    change = 0.0
    pct = 0.0
    if latest is not None and prev not in (None, 0):
        change = latest - prev
        pct = change / prev * 100

    metrics = {
        "latest": format_plain(latest),
        "open": format_plain(df["Open"].iloc[-1]),
        "high": format_plain(df["High"].iloc[-1]),
        "low": format_plain(df["Low"].iloc[-1]),
        "volume": format_volume(df["Volume"].iloc[-1]),
        "change": format_plain(change),
        "pct": f"{pct:.2f}",
        "color": "text-success" if change >= 0 else "text-danger",
    }

    # Charts (daily)
    ma_plot = chart_main(df)
    oc_hilo_plot = chart_open_close_hilo(df)
    area_plot = chart_area(df)
    ohlc_bar_plot = chart_ohlc_bars(df)
    candle_plot = chart_candlestick(df)
    volume_plot = chart_volume(df)
    returns_plot = chart_returns(df)
    cumret_plot = chart_cum_returns(df)

    # Intraday
    intraday_df = fetch_intraday(ticker)
    if intraday_df is None:
        intraday_plot = None
        intraday_error = "Intraday data not available (market closed or data source issue)."
    else:
        intraday_plot = chart_intraday_area(intraday_df)
        intraday_error = None

    # Predictions
    pred_plot = None
    future_plot = None
    pred_error = None

    if not os.path.exists(MODEL_PATH):
        pred_error = "Model file 'Latest_stock_price_model.keras' not found in project folder."
    else:
        try:
            min_lookback = 100
            close_vals = df["Close"].values.reshape(-1, 1)
            if len(close_vals) <= min_lookback + 10:
                pred_error = "Not enough history for predictions (need more than 110 data points)."
            else:
                model = load_model(MODEL_PATH)
                scaler = MinMaxScaler(feature_range=(0, 1))

                total_len = len(close_vals)
                split_idx = int(total_len * 0.7)

                train_data = close_vals[:split_idx]
                scaler.fit(train_data)

                # Test predictions
                test_data = close_vals[split_idx:]
                inputs = close_vals[total_len - len(test_data) - min_lookback:]
                inputs_scaled = scaler.transform(inputs)

                X_test = []
                for i in range(min_lookback, len(inputs_scaled)):
                    X_test.append(inputs_scaled[i - min_lookback : i])
                X_test = np.array(X_test)

                if X_test.size > 0:
                    preds_scaled = model.predict(X_test, verbose=0)
                    preds = scaler.inverse_transform(preds_scaled)

                    pred_index = df.index[split_idx:]
                    min_len = min(len(pred_index), len(preds))

                    fig1, ax1 = plt.subplots(figsize=(10, 4))
                    fig1.patch.set_facecolor("#0e1117")
                    ax1.set_facecolor("#1e1e1e")

                    ax1.plot(
                        pred_index[:min_len],
                        close_vals[split_idx : split_idx + min_len],
                        color="#00BCD4",
                        label="Actual",
                        linewidth=1.8,
                    )
                    ax1.plot(
                        pred_index[:min_len],
                        preds[:min_len],
                        color="#FFEB3B",
                        label="Predicted",
                        linestyle="--",
                        linewidth=1.5,
                    )

                    ax1.tick_params(colors="white")
                    ax1.legend(labelcolor="white", frameon=False)
                    ax1.grid(True, linestyle="--", alpha=0.25)
                    for s in ax1.spines.values():
                        s.set_visible(False)
                    pred_plot = fig_to_base64(fig1)

                # Future 30-day forecast
                last_100 = close_vals[-min_lookback:]
                last_100_scaled = scaler.transform(last_100)

                batch = last_100_scaled.reshape(1, min_lookback, 1)
                future_scaled = []
                for _ in range(30):
                    p = model.predict(batch, verbose=0)[0]
                    future_scaled.append(p)
                    batch = np.append(batch[:, 1:, :], [[p]], axis=1)

                future_scaled = np.array(future_scaled)
                future = scaler.inverse_transform(future_scaled)

                future_dates = pd.date_range(
                    start=df.index[-1] + pd.Timedelta(days=1),
                    periods=30,
                )

                fig2, ax2 = plt.subplots(figsize=(10, 4))
                fig2.patch.set_facecolor("#0e1117")
                ax2.set_facecolor("#1e1e1e")

                ax2.plot(
                    future_dates,
                    future,
                    color="#E91E63",
                    marker="o",
                    markersize=4,
                )

                ax2.tick_params(colors="white")
                ax2.grid(True, linestyle="--", alpha=0.25)
                for s in ax2.spines.values():
                    s.set_visible(False)
                future_plot = fig_to_base64(fig2)

        except Exception as e:
            pred_error = f"Model Prediction Error: {e}"

    news_items = fetch_news()
    raw_table = df.tail(10).to_html(classes="table table-dark table-striped")

    return render_template_string(
        HTML_TEMPLATE,
        ticker=ticker,
        error=None,
        metrics=metrics,
        ma_plot=ma_plot,
        oc_hilo_plot=oc_hilo_plot,
        area_plot=area_plot,
        ohlc_bar_plot=ohlc_bar_plot,
        candle_plot=candle_plot,
        volume_plot=volume_plot,
        returns_plot=returns_plot,
        cumret_plot=cumret_plot,
        intraday_plot=intraday_plot,
        intraday_error=intraday_error,
        pred_error=pred_error,
        pred_plot=pred_plot,
        future_plot=future_plot,
        news=news_items,
        raw_data=raw_table,
        datetime=datetime,
    )

if __name__ == "__main__":
    app.run(debug=True)
