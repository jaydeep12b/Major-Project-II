def chart_returns(df, days=365):
    returns = df["Close"].pct_change() * 100
    subset = returns.dropna().tail(days)

    fig, ax = plt.subplots(figsize=(10, 4))
    fig.patch.set_facecolor("#0e1117")
    ax.set_facecolor("#1e1e1e")

    ax.plot(subset.index, subset.values, linewidth=1.5)
    ax.axhline(0, linestyle="--", color="gray", alpha=0.5)
    ax.tick_params(colors="white")
    ax.grid(True, linestyle="--", alpha=0.25)
    for s in ax.spines.values():
        s.set_visible(False)
    return fig_to_base64(fig)

def chart_cum_returns(df):
    returns = df["Close"].pct_change()
    cum = (1 + returns).cumprod() - 1
    cum = cum.dropna()

    fig, ax = plt.subplots(figsize=(10, 4))
    fig.patch.set_facecolor("#0e1117")
    ax.set_facecolor("#1e1e1e")

    ax.plot(cum.index, cum.values * 100.0, linewidth=1.8)
    ax.tick_params(colors="white")
    ax.grid(True, linestyle="--", alpha=0.25)
    ax.set_ylabel("Cumulative %", color="white")
    for s in ax.spines.values():
        s.set_visible(False)
    return fig_to_base64(fig)

